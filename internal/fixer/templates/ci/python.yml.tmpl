name: CI

on:
  push:
    branches: [main, develop]
  pull_request:
    branches: [main, develop]

jobs:
  lint-test-build:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ['3.10', '3.11', '3.12']
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{"{{"}} matrix.python-version {{"}}"}}
      - name: Install
        run: pip install -e ".[dev]"
      - name: Lint
        run: flake8
      - name: Test
        run: pytest
      - name: Build
        run: python -m build
